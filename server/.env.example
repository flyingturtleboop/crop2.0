# Server environment variables — copy to .env and fill in real values.
# Do NOT commit the real .env file.

# Google OAuth credentials (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Flask secret key used to sign sessions (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:5173

# Set to "1" only for local development. Never enable in production.
FLASK_DEBUG=0
